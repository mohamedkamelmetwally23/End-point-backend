NODE_ENV=development
PORT=4000
# Local MongoDB MUST run as a replica set; multi-document writes use transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/endpoint_test?replicaSet=rs0
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=replace-with-at-least-32-random-characters
# Use none for separate frontend/backend sites over HTTPS; lax for local/same-site.
COOKIE_SAME_SITE=lax
# Required to enable the paid purchase CTA. Digits only, with country code.
WHATSAPP_NUMBER=
# Set these only when seeding the development administrator.
INITIAL_ADMIN_EMAIL=kamel@endpoint.local
INITIAL_ADMIN_PASSWORD=
# Connect separate Private and Public Vercel Blob stores. IDs are not secrets.
BLOB_PRIVATE_STORE_ID=
BLOB_PUBLIC_STORE_ID=
# Local/CI fallback credentials; never expose through VITE_* variables.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
# VERCEL_OIDC_TOKEN is managed/refreshed by Vercel and the Blob SDK.
