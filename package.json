{
  "name": "endpoint-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:storage": "node --import tsx scripts/migrate-storage.ts",
    "storage:cleanup": "node --import tsx scripts/cleanup-storage.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "vitest run tests/platform.test.ts",
    "db:reset:test": "node --import tsx scripts/reset-test-database.ts --delete-all-test-data",
    "db:reset-academic": "node --import tsx scripts/reset-academic-data.ts --reset-test-academic",
    "db:activate-first-term": "node --import tsx scripts/apply-first-term.ts --apply-test-first-term",
    "bootstrap:admin": "node --import tsx scripts/bootstrap-admin.ts",
    "lint": "eslint src tests scripts",
    "verify:setup": "node --import tsx scripts/verify-setup.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
